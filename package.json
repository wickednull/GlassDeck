{
  "name": "glassdeck",
  "productName": "GlassDeck",
  "version": "0.1.0",
  "description": "A liquid-glass launcher for Linux AppImages",
  "main": "electron/main.cjs",
  "desktopName": "glassdeck.desktop",
  "author": "null",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n ui,app -c cyan,magenta \"vite\" \"wait-on tcp:127.0.0.1:5173 && VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "start": "vite build && electron .",
    "shot": "vite build && GLASSDECK_SHOT=/tmp/glassdeck-shot.png electron .",
    "dist": "vite build && electron-builder --linux AppImage",
    "install:user": "bash scripts/install-user.sh"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.2.0",
    "electron": "^38.2.2",
    "electron-builder": "^26.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.4.0",
    "wait-on": "^9.0.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "lucide-react": "^1.81.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "build": {
    "appId": "dev.glassdeck.launcher",
    "productName": "GlassDeck",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "synopsis": "Liquid-glass launcher for AppImages",
      "syncDesktopName": true
    }
  }
}
